// ---------------------------------------------------------------------------
// Prisma schema for the Landlord/Tenant Relay Messaging Platform.
//
// Phase 1 (Foundation) fully wires up: User, UserProfile, PhoneNumber,
// PhoneVerification, Property, PropertyUnit, PropertyManagerAssignment,
// AuditLog, RefreshToken.
//
// The remaining models (Conversation, Message, moderation, scheduling,
// applications, leases, notifications, ...) are defined now so later phases
// never require a destructive schema rewrite, but their service/controller
// layers are implemented in the phases that use them.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PROSPECTIVE_TENANT
  CURRENT_TENANT
  LANDLORD
  PROPERTY_MANAGER
  LENDER
  EMPLOYER
  STAFF_MODERATOR
  ADMINISTRATOR
  SUPER_ADMINISTRATOR
}

enum LenderAccessTier {
  BASIC
  PREMIUM
}

enum LenderRequestStatus {
  PENDING
  FULFILLED
  DECLINED
}

enum PropertyType {
  APARTMENT
  HOUSE
  CONDO
  TOWNHOME
  OTHER
}

enum UtilityType {
  ELECTRIC
  WATER
  GAS
  TRASH
  LAWN_SERVICE
  INTERNET
  CABLE
  PARKING
}

enum SewerSourceType {
  CITY_SEWER
  SEPTIC
}

enum WaterSourceType {
  CITY_WATER
  WELL
}

enum SchoolLevel {
  PRESCHOOL
  ELEMENTARY
  MIDDLE
  HIGH
  OTHER
}

enum SchoolType {
  PUBLIC
  PRIVATE
  CHARTER
  OTHER
}

enum ConversationStatus {
  NEW_INQUIRY
  ACTIVE
  SHOWING_REQUESTED
  SHOWING_SCHEDULED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_DENIED
  LEASE_PENDING
  LEASE_SIGNED
  CURRENT_TENANT
  CLOSED
  BLOCKED
  UNDER_REVIEW
}

enum ConversationParticipantRole {
  TENANT
  LANDLORD
  PROPERTY_MANAGER
  STAFF
}

enum ApplicationStatus {
  NOT_STARTED
  STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  WITHDRAWN
}

enum LeaseStatus {
  NONE
  PENDING
  SIGNED
  ACTIVE
  RENEWAL_PENDING
  RENEWED
  TERMINATED
  EXPIRED
}

enum ModerationStatus {
  NONE
  FLAGGED
  UNDER_REVIEW
  CLEARED
  BLOCKED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  SMS
  IN_APP
}

enum ModerationDecision {
  PENDING
  APPROVED
  BLOCKED
  AUTO_APPROVED
}

enum MessageStatus {
  DRAFT
  RECEIVED
  PENDING_MODERATION
  BLOCKED
  APPROVED
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERABLE
  READ_IN_APP
  DELETED_BY_ADMIN
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERABLE
}

enum ViolationType {
  PHONE_NUMBER
  EMAIL
  URL
  SOCIAL_MEDIA
  PAYMENT_HANDLE
  QR_CODE
  OFF_PLATFORM_REQUEST
  OTHER
}

enum DetectionMethod {
  REGEX
  NORMALIZATION
  KEYWORD
  PATTERN
  HISTORY_ANALYSIS
  AI_FALLBACK
  IMAGE_ANALYSIS
}

enum ViolationAction {
  EDUCATIONAL_WARNING
  STRONG_WARNING
  TEMP_RESTRICTION
  MODERATOR_REVIEW
  SUSPENSION
  ADMIN_OVERRIDE
}

enum RestrictionType {
  MESSAGING_RESTRICTED
  SUSPENDED
  BLOCKED
}

enum ShowingStatus {
  REQUESTED
  SLOT_PROPOSED
  SCHEDULED
  RESCHEDULE_PROPOSED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum IdSubmissionStatus {
  AWAITING_PAYMENT
  PAID
  SUBMITTED
  CANCELLED
}

enum UnitListingType {
  // The whole unit is rented as one — today's only behavior, and the
  // default so existing units are unaffected.
  ENTIRE_PLACE
  // A single bedroom within the unit, rented individually; the tenant has
  // exclusive use of that room but shares common areas.
  PRIVATE_ROOM
  // A room shared by multiple tenants, each renting their own Bed within
  // it rather than the room as a whole.
  SHARED_ROOM
}

enum GigJobStatus {
  OPEN
  CLAIMED
  COMPLETED
  CONFIRMED
  CANCELLED
}

enum GigVoucherStatus {
  ISSUED
  APPLIED
}

enum JobReferralStatus {
  // Sponsored listings only — created but not yet paid for, so not shown to anyone.
  PENDING_PAYMENT
  ACTIVE
  CLOSED
}

// Which billing effect a sponsored listing's currently-in-flight checkout will
// apply once its payment webhook confirms. Cleared back to null after the
// webhook is processed, which is also what makes a replayed webhook event a
// safe no-op.
enum JobReferralPendingOperation {
  ACTIVATE
  TOPUP
  RENEW
}

enum ConsentType {
  TRANSACTIONAL
  MARKETING
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
  PENDING
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  CONTAINS_CONTACT_INFO
  REJECTED
}

enum CurrentTenantCategory {
  MAINTENANCE
  RENT_QUESTION
  LEASE_QUESTION
  EMERGENCY
  INSPECTION
  RENEWAL
  NOTICE
  COMPLAINT
  GENERAL
}

// ---------------------------------------------------------------------------
// Identity / Auth
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              Role
  isActive          Boolean   @default(true)
  // Per-moderator grant, set only by an ADMINISTRATOR/SUPER_ADMINISTRATOR:
  // lets a STAFF_MODERATOR suspend/restore non-staff accounts themselves
  // instead of escalating to an admin. Meaningless for any other role.
  canSuspendUsers   Boolean   @default(false)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile               UserProfile?
  phoneNumbers          PhoneNumber[]
  refreshTokens         RefreshToken[]
  ownedProperties       Property[]                   @relation("PropertyOwner")
  managerAssignments    PropertyManagerAssignment[]
  conversationsAsTenant   Conversation[]              @relation("ConversationTenant")
  conversationsAsLandlord Conversation[]              @relation("ConversationLandlord")
  conversationParticipants ConversationParticipant[]
  sentMessages          Message[]                    @relation("MessageSender")
  receivedMessages      Message[]                     @relation("MessageRecipient")
  violations            Violation[]
  restrictions          UserRestriction[]             @relation("RestrictionUser")
  restrictionsImposed   UserRestriction[]              @relation("RestrictionImposedBy")
  notificationPreference NotificationPreference?
  consentEvents         ConsentEvent[]
  auditLogs             AuditLog[]
  adminNotes            AdminNote[]                   @relation("AdminNoteAuthor")
  moderationFlagsReviewed ModerationFlag[]             @relation("ModerationFlagReviewer")
  waitlistEntries       PropertyWaitlistEntry[]
  lenderAssignments     LenderAssignment[]             @relation("LenderAssignmentLender")
  tenantLenderAssignments LenderAssignment[]            @relation("LenderAssignmentTenant")
  lenderAssignmentsCreated LenderAssignment[]           @relation("LenderAssignmentAssignedBy")
  gigJobsPosted         GigJob[]                     @relation("GigJobPoster")
  gigJobsClaimed        GigJob[]                     @relation("GigJobClaimedBy")
  gigVouchersReceived   GigVoucher[]                 @relation("GigVoucherTenant")
  gigVouchersIssued     GigVoucher[]                 @relation("GigVoucherLandlord")
  jobReferralsPosted    JobReferral[]                @relation("JobReferralPoster")
  jobReferralClicks     JobReferralClick[]           @relation("JobReferralClickTenant")
  landlordSubscription  LandlordSubscription?
  hqsInspectionRequests HqsInspectionRequest[]
  tenantPacket          TenantPacket?
  homeownershipProgress HomeownershipProgress?
  voucherDocument       VoucherDocument?

  @@index([role])
}

model RefreshToken {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  familyId         String
  revokedAt        DateTime?
  replacedByTokenId String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([familyId])
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  avatarUrl    String?
  bio          String?
  timezone     String   @default("America/New_York")
  locale       String   @default("en")

  // Landlord-only onboarding questions, collected at registration. Used to
  // identify which service gaps the platform can offer to fill (outsourced
  // vendor referrals) and whether the landlord wants help finding a
  // property manager. Meaningless for non-landlord roles.
  hasLawnCareProvider            Boolean @default(false)
  hasPlumbingProvider            Boolean @default(false)
  hasHandymanProvider            Boolean @default(false)
  hasPestControlProvider         Boolean @default(false)
  hasRoofingProvider             Boolean @default(false)
  requestsPropertyManagementHelp Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Real phone numbers are NEVER stored in plaintext. `encryptedNumber` holds an
// AES-256-GCM ciphertext (iv + tag + ciphertext, base64). `numberHash` is an
// HMAC-SHA256 keyed hash used strictly for lookups/dedup/routing so the raw
// number is never needed outside the encryption service.
model PhoneNumber {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedNumber String
  numberHash      String    @unique
  last4           String
  countryCode     String    @default("US")
  isVerified      Boolean   @default(false)
  isPrimary       Boolean   @default(false)
  verifiedAt      DateTime?
  supersededAt    DateTime?
  createdAt       DateTime  @default(now())

  verifications PhoneVerification[]

  @@index([userId])
  @@index([numberHash])
}

model PhoneVerification {
  id            String    @id @default(uuid())
  phoneNumberId String
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  codeHash      String
  attempts      Int       @default(0)
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([phoneNumberId])
}

// ---------------------------------------------------------------------------
// Properties
// ---------------------------------------------------------------------------

model Property {
  id               String   @id @default(uuid())
  ownerId          String
  owner            User     @relation("PropertyOwner", fields: [ownerId], references: [id])
  title            String
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  zip              String
  country          String   @default("US")
  latitude         Float?
  longitude        Float?
  // Set the first time the address is successfully geocoded; refreshed
  // (along with nearbySchools) whenever the address changes. Null means
  // geocoding hasn't succeeded yet — a transient provider failure at
  // create/update time never blocks saving the listing itself.
  schoolsFetchedAt DateTime?
  description      String?
  monthlyRentCents Int?
  depositCents     Int?
  petPolicy        String?
  photoUrl         String?
  isActive         Boolean  @default(true)
  propertyType     PropertyType @default(OTHER)
  acceptsSection8Vouchers Boolean @default(false)
  amenities        String?
  utilitiesIncluded UtilityType[] @default([])

  // Separate, specific utility facts — kept distinct from the generic
  // utilitiesIncluded checklist above rather than folded into it, since
  // these are yes/no facts a tenant screens on individually.
  sewerSource              SewerSourceType?
  waterSource              WaterSourceType?
  landlordPaysElectricity  Boolean @default(false)
  landlordPaysWater        Boolean @default(false)

  subleaseAllowed  Boolean  @default(false)
  currentLeaseEndDate DateTime?

  // Landlord-set flags surfaced to prospective/current tenants alongside
  // the standard listing terms.
  sellingSoon               Boolean @default(false)
  sellingSoonNote           String?
  rentToOwnAvailable        Boolean @default(false)
  leaseToOwnAvailable       Boolean @default(false)
  sellerFinancingAvailable  Boolean @default(false)
  workForRentAvailable      Boolean @default(false)
  tenantSwapAllowed         Boolean @default(false)

  // Landlord signals openness to applicants with a prior eviction, credit
  // issue, or justice-involvement — surfaced as a search filter/badge
  // ("Second-Chance Friendly") alongside acceptsSection8Vouchers. Kept as a
  // plain yes/no flag rather than free text, since screening criteria (not
  // demographic language) is what stays fair-housing-safe.
  secondChanceFriendly      Boolean @default(false)

  // Granular screening criteria a landlord can state up front, so a
  // second-chance renter doesn't waste an application fee on a mismatch —
  // each is optional and defaults to not-stated/false, same fair-housing
  // rationale as secondChanceFriendly above (screening criteria, not
  // demographic language).
  brokenLeaseOk             Boolean @default(false)
  cosignerAccepted          Boolean @default(false)
  noCreditCheckIncomeOnly   Boolean @default(false)
  // Landlord-stated "evictions older than N years OK"; null = not stated.
  evictionAgeToleranceYears Int?

  // "Featured Listing Boost": a flat one-time fee that surfaces this
  // property first in search results for 30 days. `boostedUntil` in the
  // future means currently boosted; a lapsed (past) or null value means
  // not boosted — findAll() ranks boostedUntil > now first, then falls
  // back to createdAt desc. The three `boostPayment*` fields track an
  // outstanding checkout the same way IdSubmission tracks its payment
  // fields, and are cleared once the webhook applies it.
  boostedUntil                   DateTime?
  boostPaymentProviderCheckoutId String?
  boostPaymentOrderId            String?
  boostCheckoutUrl               String?

  // Incremented once per flip-to-details on the public home feed (see
  // PropertiesService.recordView) — the popularity signal the feed's
  // weighted-random sampling favors. Not a page-view counter; a property
  // never seen on the feed simply stays at 0.
  viewCount        Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  units               PropertyUnit[]
  managerAssignments  PropertyManagerAssignment[]
  conversations       Conversation[]
  waitlistEntries     PropertyWaitlistEntry[]
  lenderAssignments   LenderAssignment[]
  nearbySchools       NearbySchool[]
  gigJobs             GigJob[]
  hqsInspectionRequests HqsInspectionRequest[]

  @@index([ownerId])
  @@index([city, state])
  @@index([latitude, longitude])
  @@index([boostPaymentOrderId])
}

model PropertyUnit {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitLabel   String
  bedrooms    Int?
  bathrooms  Float?
  squareFeet  Int?
  rentCents   Int?
  isAvailable Boolean  @default(true)
  // ENTIRE_PLACE (default) rents the whole unit as one, matching the
  // platform's original behavior. PRIVATE_ROOM/SHARED_ROOM mark a unit as
  // itself being one bedroom of a larger home rented room-by-room; a
  // SHARED_ROOM's actual rentable sub-listings live in `beds` below.
  listingType UnitListingType @default(ENTIRE_PLACE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  applications  Application[]
  leases        Lease[]
  beds          Bed[]

  @@unique([propertyId, unitLabel])
}

// A single bed within a SHARED_ROOM unit — individually rentable, with its
// own rent, availability, and inquiry thread, the same shape as
// PropertyUnit itself but one level finer. Meaningless for
// ENTIRE_PLACE/PRIVATE_ROOM units, which are rented as a whole.
model Bed {
  id          String       @id @default(uuid())
  unitId      String
  unit        PropertyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bedLabel    String
  rentCents   Int?
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  conversations Conversation[]
  applications  Application[]
  leases        Lease[]

  @@unique([unitId, bedLabel])
  @@index([unitId])
}

model PropertyManagerAssignment {
  id         String    @id @default(uuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@unique([propertyId, userId])
  @@index([userId])
}

// A tenant joining the waitlist for a property that is not currently
// available. Ordered by createdAt (first-come, first-served) when the
// landlord reviews the queue.
model PropertyWaitlistEntry {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([propertyId])
}

// A published HUD Small Area Fair Market Rent (the basis for a housing
// authority's voucher "payment standard") for one zip code and bedroom
// count. Duval County, FL is a Small Area FMR county, so — unlike most of
// the country, where one FMR covers an entire metro area — HUD publishes a
// distinct figure per zip code here. `bedrooms` is 0 (studio) through 4,
// where 4 stands for "4 or more" (HUD's own FMR tables stop at 4). Seeded
// from HUD's FY2026 published SAFMR table (effective 2025-10-01) for the 20
// zip codes HUD designates as Duval County's Small Area FMR zips; a zip
// code not present here simply isn't covered yet, not "zero rent."
model PaymentStandard {
  id                String   @id @default(uuid())
  zip               String
  bedrooms          Int
  monthlyRentCents  Int
  metroArea         String   @default("Jacksonville, FL HUD Metro FMR Area")
  effectiveDate     DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([zip, bedrooms])
  @@index([zip])
}

// Cached result of a SchoolsProvider.findNearby() lookup for a property's
// geocoded coordinates. Cached (rather than fetched live on every listing
// view) since the upstream schools API is metered per call and school
// assignments/ratings change slowly; refreshed whenever the address
// changes or a refresh is explicitly requested.
model NearbySchool {
  id            String     @id @default(uuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  externalId    String?
  name          String
  schoolType    SchoolType  @default(OTHER)
  level         SchoolLevel @default(OTHER)
  rating        Int?
  distanceMiles Float?
  address       String?
  websiteUrl    String?
  createdAt     DateTime   @default(now())

  @@index([propertyId])
}

// A lender given read access to one property, assigned by an administrator
// (not the landlord) so access — and future paid tiers — stay centrally
// controlled. tenantId marks which tenant's profile the lender can see;
// the admin updates it as tenants change.
model LenderAssignment {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lenderId     String
  lender       User     @relation("LenderAssignmentLender", fields: [lenderId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       User?    @relation("LenderAssignmentTenant", fields: [tenantId], references: [id])
  assignedById String
  assignedBy   User     @relation("LenderAssignmentAssignedBy", fields: [assignedById], references: [id])
  accessTier   LenderAccessTier @default(BASIC)
  assignedAt   DateTime @default(now())
  revokedAt    DateTime?

  requests LenderPaymentRequest[]

  @@unique([propertyId, lenderId])
  @@index([lenderId])
  @@index([tenantId])
}

// A lender's ask for payment/income proof from the assignment's tenant. No
// financial data or uploaded file content is ever persisted here — only
// metadata about the request/response. The tenant's actual submission is
// forwarded straight through as an email attachment and discarded.
model LenderPaymentRequest {
  id                 String   @id @default(uuid())
  lenderAssignmentId String
  lenderAssignment   LenderAssignment @relation(fields: [lenderAssignmentId], references: [id], onDelete: Cascade)
  message            String?
  status             LenderRequestStatus @default(PENDING)
  responseNote       String?
  responseFileName   String?
  emailSent          Boolean  @default(false)
  createdAt          DateTime @default(now())
  respondedAt        DateTime?

  @@index([lenderAssignmentId])
}

// ---------------------------------------------------------------------------
// Conversations / Messaging (wired up in Phase 2)
// ---------------------------------------------------------------------------

model Conversation {
  id                String             @id @default(uuid())
  propertyId        String
  property          Property           @relation(fields: [propertyId], references: [id])
  unitId            String?
  unit              PropertyUnit?      @relation(fields: [unitId], references: [id])
  bedId             String?
  bed               Bed?               @relation(fields: [bedId], references: [id])
  tenantId          String
  tenant            User               @relation("ConversationTenant", fields: [tenantId], references: [id])
  landlordId        String
  landlord          User               @relation("ConversationLandlord", fields: [landlordId], references: [id])
  status            ConversationStatus @default(NEW_INQUIRY)
  applicationStatus ApplicationStatus  @default(NOT_STARTED)
  leaseStatus       LeaseStatus        @default(NONE)
  moderationStatus  ModerationStatus   @default(NONE)
  createdAt         DateTime           @default(now())
  lastMessageAt     DateTime?
  closedAt          DateTime?

  participants     ConversationParticipant[]
  messages         Message[]
  relayAssignments RelayAssignment[]
  showings         Showing[]
  idSubmissions    IdSubmission[]
  claimedGigJobs   GigJob[]
  applications     Application[]
  leases           Lease[]
  contactReleases  ContactRelease[]
  moderationFlags  ModerationFlag[]
  violations       Violation[]
  adminNotes       AdminNote[]
  voucherAccessRequest VoucherAccessRequest?

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
}

model ConversationParticipant {
  id             String                      @id @default(uuid())
  conversationId String
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                        @relation(fields: [userId], references: [id])
  role           ConversationParticipantRole
  joinedAt       DateTime                    @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id                  String              @id @default(uuid())
  conversationId      String
  conversation        Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId            String?
  sender               User?              @relation("MessageSender", fields: [senderId], references: [id])
  recipientId          String?
  recipient            User?              @relation("MessageRecipient", fields: [recipientId], references: [id])
  direction            MessageDirection
  channel              MessageChannel      @default(SMS)
  originalContent      String
  sanitizedContent     String?
  moderationDecision   ModerationDecision  @default(PENDING)
  status               MessageStatus       @default(RECEIVED)
  providerMessageId    String?             @unique
  idempotencyKey       String?             @unique
  sentAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime            @default(now())

  deliveries  MessageDelivery[]
  attachments MessageAttachment[]
  moderationFlags ModerationFlag[]
  violations  Violation[]

  @@index([conversationId])
  @@index([status])
}

model MessageDelivery {
  id                String         @id @default(uuid())
  messageId         String
  message           Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  provider          String
  providerMessageId String?
  status            DeliveryStatus
  rawPayload        Json?
  occurredAt        DateTime
  createdAt         DateTime       @default(now())

  @@index([messageId])
}

model MessageAttachment {
  id             String               @id @default(uuid())
  messageId      String
  message        Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey     String
  fileType       String
  fileSizeBytes  Int
  scanStatus     AttachmentScanStatus @default(PENDING)
  scanResult     Json?
  sanitizedStorageKey String?
  createdAt      DateTime             @default(now())

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Relay number pool / routing
// ---------------------------------------------------------------------------

model RelayNumber {
  id             String   @id @default(uuid())
  phoneNumber    String   @unique
  provider       String
  isActive       Boolean  @default(true)
  region         String?
  capacityLimit  Int      @default(50)
  createdAt      DateTime @default(now())

  assignments RelayAssignment[]
}

model RelayAssignment {
  id             String       @id @default(uuid())
  relayNumberId  String
  relayNumber    RelayNumber  @relation(fields: [relayNumberId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedAt     DateTime     @default(now())
  releasedAt     DateTime?

  @@unique([conversationId])
  @@index([relayNumberId])
}

// ---------------------------------------------------------------------------
// Showings (Phase 4)
// ---------------------------------------------------------------------------

model Showing {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         ShowingStatus @default(REQUESTED)
  scheduledAt    DateTime?
  durationMinutes Int          @default(30)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cancelledAt    DateTime?
  completedAt    DateTime?

  timeSlots ShowingTimeSlot[]

  @@index([conversationId])
}

model ShowingTimeSlot {
  id         String   @id @default(uuid())
  showingId  String
  showing    Showing  @relation(fields: [showingId], references: [id], onDelete: Cascade)
  proposedBy String
  startTime  DateTime
  endTime    DateTime
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([showingId])
}

// A tenant's paid ID submission for a conversation: a $5 convenience fee
// gates the tenant actually attaching an ID file, which — once paid — is
// forwarded straight through as an email attachment to whoever is currently
// responsible for the conversation (conversation.landlordId, i.e. the
// assigned property manager/realtor if one exists, otherwise the owner) and
// never persisted here, matching the LenderPaymentRequest pattern.
model IdSubmission {
  id                String             @id @default(uuid())
  conversationId    String
  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feeCents          Int                @default(500)
  status            IdSubmissionStatus @default(AWAITING_PAYMENT)
  paymentProviderCheckoutId String?
  paymentOrderId    String?
  checkoutUrl       String?
  paidAt            DateTime?
  submittedFileName String?
  emailSent         Boolean            @default(false)
  submittedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([conversationId])
  @@index([paymentOrderId])
}

enum SubscriptionTier {
  FREE
  PRO
  UNLIMITED
}

// One row per landlord/property manager, upserted to FREE the first time
// GET /subscriptions/me is called. A paid tier is a flat 30-day period a
// landlord pays to renew — not processor-side recurring billing (nothing in
// this codebase's PaymentProvider abstraction models a subscription, only a
// one-time checkout), so `expiresAt` simply lapses back to FREE-equivalent
// behavior if never renewed; nothing here auto-charges.
model LandlordSubscription {
  id       String           @id @default(uuid())
  userId   String           @unique
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier     SubscriptionTier @default(FREE)
  expiresAt DateTime?

  // Set while a checkout for an upgrade/renewal is outstanding; applied to
  // `tier` (with a fresh expiresAt) once the payment webhook confirms
  // payment, then cleared — mirrors IdSubmission's AWAITING_PAYMENT guard,
  // making webhook redelivery a no-op.
  pendingTier               SubscriptionTier?
  paymentProviderCheckoutId String?
  paymentOrderId            String?
  checkoutUrl               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentOrderId])
}

enum HqsInspectionStatus {
  AWAITING_PAYMENT
  PAID
  // Landlord has supplied a preferred date/note after paying, emailed to
  // the inspections team — this platform has no real inspector-assignment
  // or scheduling workflow, so REQUESTED is the terminal state, the same
  // way an IdSubmission's "email it and stop tracking" is terminal.
  REQUESTED
  CANCELLED
}

// A landlord/manager-requested HQS pre-inspection walkthrough for one
// property: pay a flat $199 fee, then supply a preferred date/note that's
// emailed to the inspections team — mirrors IdSubmission's
// pay-then-fee-gated-action shape, just property-scoped instead of
// conversation-scoped, and emailing an internal team instead of a landlord.
model HqsInspectionRequest {
  id            String              @id @default(uuid())
  propertyId    String
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  feeCents      Int                 @default(19900)
  status        HqsInspectionStatus @default(AWAITING_PAYMENT)

  paymentProviderCheckoutId String?
  paymentOrderId            String?
  checkoutUrl               String?
  paidAt                    DateTime?

  preferredDateNote String?
  requestedAt       DateTime?
  emailSent         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([paymentOrderId])
}

enum TenantPacketStatus {
  NOT_STARTED
  AWAITING_PAYMENT
  PAID
  SUBMITTED
}

// A tenant's reusable "Fast-Track" application packet: pay a flat $29 fee
// once, fill it out once, then share it into any conversation — unlike
// IdSubmission (created fresh per-conversation, since ID verification is
// specific to one landlord relationship), the whole point of a Fast-Track
// packet is not re-paying/re-typing the same income proof and background
// explanation for every landlord a tenant messages. One row per tenant.
model TenantPacket {
  id       String             @id @default(uuid())
  tenantId String             @unique
  tenant   User               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeCents Int                @default(2900)
  status   TenantPacketStatus @default(NOT_STARTED)

  paymentProviderCheckoutId String?
  paymentOrderId            String?
  checkoutUrl               String?
  paidAt                    DateTime?

  // Unlike IdSubmission (which emails an uploaded file immediately and
  // never stores it), a Fast-Track packet is filled out once and shared
  // into many conversations afterward, so the file itself has to be
  // persisted somewhere to attach on each later share.
  incomeProofFileName  String?
  incomeProofMimeType  String?
  incomeProofFile      Bytes?
  backgroundExplanation String?
  // Legacy free-text references — kept for existing submitted packets.
  // New submissions use the structured referenceContacts below instead.
  references           String?
  monthlyIncomeCents    Int?
  employerName          String?
  submittedAt           DateTime?

  referenceContacts TenantPacketReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentOrderId])
}

// Structured reference contact for a Tenant Fast-Track Packet — replaces the
// legacy free-text `references` column for new submissions. Full-replace on
// each submit() call (delete + recreate) rather than diffed, since this is
// low-volume personal data attached to one packet.
model TenantPacketReference {
  id             String       @id @default(uuid())
  tenantPacketId String
  tenantPacket   TenantPacket @relation(fields: [tenantPacketId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  relationship   String?
  createdAt      DateTime     @default(now())

  @@index([tenantPacketId])
}

// Admin-managed milestone definitions for the Homeownership Progress Tracker —
// the checklist content itself, editable without a code change. Global, not
// scoped to any one tenant.
model HomeownershipMilestone {
  id        String   @id @default(uuid())
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions HomeownershipMilestoneCompletion[]
}

// One row per tenant — savings goal/current amount, mirrors TenantPacket's
// one-row-per-tenant shape (tenantId unique, lazily created on first real
// update rather than on first read).
model HomeownershipProgress {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  tenant              User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savingsGoalCents    Int?
  currentSavingsCents Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  completions HomeownershipMilestoneCompletion[]
}

// Join row: this tenant has completed this milestone, and when.
model HomeownershipMilestoneCompletion {
  id          String                 @id @default(uuid())
  progressId  String
  progress    HomeownershipProgress  @relation(fields: [progressId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   HomeownershipMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  completedAt DateTime               @default(now())

  @@unique([progressId, milestoneId])
  @@index([progressId])
  @@index([milestoneId])
}

enum VoucherAccessStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// The tenant's uploaded HUD Housing Choice Voucher. One row per tenant (like
// TenantPacket), replaced in place on re-upload. Bytes live directly in
// Postgres — the only other precedent for this is TenantPacket.incomeProofFile.
model VoucherDocument {
  id         String   @id @default(uuid())
  tenantId   String   @unique
  tenant     User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  fileData   Bytes
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// One evolving row per conversation — a landlord's standing request to view a
// tenant's voucher. No direct FK to VoucherDocument; the tenant's document is
// reached via conversation.tenant.voucherDocument, mirroring how
// LenderPaymentRequest reaches its tenant via lenderAssignment.tenantId rather
// than duplicating the relationship. Re-requesting after DECLINED/REVOKED
// resets the same row to PENDING rather than growing a history table — the
// full history of accept/decline/revoke/re-request actions is preserved
// separately via the existing @AuditLog/audit-table mechanism.
model VoucherAccessRequest {
  id             String              @id @default(uuid())
  conversationId String              @unique
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         VoucherAccessStatus @default(PENDING)
  message        String?
  createdAt      DateTime            @default(now())
  respondedAt    DateTime?

  @@index([conversationId])
}

// A small paid task a landlord/property manager posts for their own tenants,
// or an admin posts for every tenant on the platform — aimed at giving a
// tenant a way to earn rent relief, not spending money, so completing one
// never pays cash: it produces a GigVoucher instead. `claimedConversation`
// is how eligibility is checked (a landlord-posted job requires a
// conversation with that same landlord) and how the resulting voucher gets
// attributed to the right landlord — this platform has no Lease/rent-ledger
// flow actually wired up yet, so the tenant-landlord Conversation is the one
// real, populated signal of "who does this tenant rent from."
model GigJob {
  id                    String        @id @default(uuid())
  posterId              String
  poster                User          @relation("GigJobPoster", fields: [posterId], references: [id])
  // Snapshotted at post time: LANDLORD/PROPERTY_MANAGER posts are scoped to
  // their own tenants; ADMINISTRATOR/SUPER_ADMINISTRATOR posts are visible
  // platform-wide. A later role change never retroactively changes this.
  posterRole            Role
  propertyId            String?
  property              Property?     @relation(fields: [propertyId], references: [id])
  title                 String
  description           String
  payoutCents           Int
  status                GigJobStatus  @default(OPEN)
  claimedById           String?
  claimedBy             User?         @relation("GigJobClaimedBy", fields: [claimedById], references: [id])
  claimedConversationId String?
  claimedConversation   Conversation? @relation(fields: [claimedConversationId], references: [id])
  claimedAt             DateTime?
  completedAt           DateTime?
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  paymentProviderCheckoutId String?
  paymentOrderId        String?
  checkoutUrl           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  voucher               GigVoucher?

  @@index([posterId])
  @@index([status])
  @@index([paymentOrderId])
}

// Rent-relief credit produced by a confirmed GigJob. The platform only
// documents that it was issued and, later, that the landlord marked it
// applied — actually reducing what's owed happens off-platform, however
// that landlord and tenant already track rent.
model GigVoucher {
  id           String           @id @default(uuid())
  gigJobId     String           @unique
  gigJob       GigJob           @relation(fields: [gigJobId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       User             @relation("GigVoucherTenant", fields: [tenantId], references: [id])
  landlordId   String
  landlord     User             @relation("GigVoucherLandlord", fields: [landlordId], references: [id])
  payoutCents  Int
  feeCents     Int
  voucherCents Int
  status       GigVoucherStatus @default(ISSUED)
  appliedAt    DateTime?
  appliedNote  String?
  createdAt    DateTime         @default(now())

  @@index([tenantId])
  @@index([landlordId])
}

// A landlord/property manager/admin sharing word of a real, external job
// opening (e.g. "McDonald's on Main St is hiring") they have no control
// over and aren't paying for — pure information-sharing, deliberately with
// no payment/voucher fields at all, unlike GigJob. Visibility scoping
// mirrors GigJob (own tenants via an existing Conversation, or
// platform-wide for admins) without any of GigJob's liability surface.
//
// The `sponsored` variant of this same model is the opposite of that: a
// self-serve, prepaid advertisement an EMPLOYER (or admin, on an employer's
// behalf) pays the platform to run — same Google/Facebook-Ads shape as
// every other paid job board. It bypasses the own-tenant scoping entirely
// (that's what the money buys: reach across the whole platform) and is
// billed per click against a prepaid budget plus a small recurring monthly
// fee, both charged through the same PaymentProvider checkout every other
// paid flow in this app uses.
model JobReferral {
  id           String            @id @default(uuid())
  posterId     String
  poster       User              @relation("JobReferralPoster", fields: [posterId], references: [id])
  posterRole   Role
  title        String
  employerName String
  location     String
  applyUrl     String?
  contactInfo  String?
  description  String?
  status       JobReferralStatus @default(ACTIVE)
  closedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // --- Sponsored (paid) listings only; null/0 for organic referrals. ---
  sponsored            Boolean   @default(false)
  costPerClickCents    Int?
  monthlyFeeCents      Int?
  budgetRemainingCents Int       @default(0)
  // Billed clicks only — a click that arrives after the budget is already
  // exhausted still lets the tenant through to the employer's apply link,
  // it just isn't charged or counted here.
  clickCount           Int       @default(0)
  currentPeriodEnd     DateTime?
  pendingOperation     JobReferralPendingOperation?
  // The budget-cents portion of whatever checkout is currently in flight
  // (0 for a pure RENEW, since that only pays the monthly fee).
  pendingBudgetCents   Int?
  paymentProviderCheckoutId String?
  paymentOrderId       String?
  checkoutUrl          String?

  clicks JobReferralClick[]

  @@index([posterId])
  @@index([status])
  @@index([paymentOrderId])
}

// One billable click on a sponsored JobReferral. The unique constraint is
// the entire fraud-prevention mechanism here: at most one billed click per
// tenant per calendar day per listing, so refreshing the page or clicking
// twice never double-charges the employer.
model JobReferralClick {
  id            String      @id @default(uuid())
  jobReferralId String
  jobReferral   JobReferral @relation(fields: [jobReferralId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        User        @relation("JobReferralClickTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  clickDate     String
  createdAt     DateTime    @default(now())

  @@unique([jobReferralId, tenantId, clickDate])
  @@index([jobReferralId])
}

// ---------------------------------------------------------------------------
// Applications / Leases (Phase 4)
// ---------------------------------------------------------------------------

model Application {
  id             String            @id @default(uuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId       String
  propertyId     String
  unitId         String?
  unit           PropertyUnit?     @relation(fields: [unitId], references: [id])
  bedId          String?
  bed            Bed?              @relation(fields: [bedId], references: [id])
  status         ApplicationStatus @default(STARTED)
  submittedAt    DateTime?
  decisionAt     DateTime?
  decisionBy     String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([conversationId])
  @@index([tenantId])
}

model Lease {
  id             String      @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  propertyId     String
  unitId         String?
  unit           PropertyUnit? @relation(fields: [unitId], references: [id])
  bedId          String?
  bed            Bed?          @relation(fields: [bedId], references: [id])
  tenantId       String
  landlordId     String
  status         LeaseStatus @default(PENDING)
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime?
  documentStorageKey String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contactReleases ContactRelease[]

  @@index([conversationId])
}

model ContactRelease {
  id                 String    @id @default(uuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leaseId            String?
  lease               Lease?    @relation(fields: [leaseId], references: [id])
  releasedBy          String
  reason              String
  releasedAt           DateTime  @default(now())
  tenantNotifiedAt     DateTime?
  landlordNotifiedAt   DateTime?
  createdAt            DateTime  @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Moderation (Phase 3)
// ---------------------------------------------------------------------------

model ModerationFlag {
  id               String            @id @default(uuid())
  messageId        String
  message          Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flagType         ViolationType
  detectionMethod  DetectionMethod
  confidenceScore  Float
  status           ModerationStatus  @default(FLAGGED)
  reviewedById     String?
  reviewedBy       User?             @relation("ModerationFlagReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  decision         String?
  createdAt        DateTime          @default(now())

  @@index([messageId])
  @@index([conversationId])
}

model Violation {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id])
  conversationId     String
  conversation       Conversation    @relation(fields: [conversationId], references: [id])
  messageId          String
  message            Message         @relation(fields: [messageId], references: [id])
  violationType      ViolationType
  detectionMethod    DetectionMethod
  confidenceScore    Float
  originalContent    String
  sanitizedContent   String?
  actionTaken        ViolationAction
  moderatorDecision  String?
  createdAt          DateTime        @default(now())

  @@index([userId])
  @@index([conversationId])
}

model UserRestriction {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation("RestrictionUser", fields: [userId], references: [id])
  type           RestrictionType
  reason         String
  imposedById    String?
  imposedBy      User?           @relation("RestrictionImposedBy", fields: [imposedById], references: [id])
  startsAt       DateTime        @default(now())
  endsAt         DateTime?
  liftedAt       DateTime?
  liftedById     String?
  createdAt      DateTime        @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications / Consent (Phase 4/5)
// ---------------------------------------------------------------------------

model NotificationPreference {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsTransactionalConsent ConsentStatus @default(PENDING)
  smsMarketingConsent     ConsentStatus @default(OPTED_OUT)
  quietHoursStart         String?
  quietHoursEnd           String?
  timezone                String    @default("America/New_York")
  consentUpdatedAt        DateTime  @default(now())
  createdAt               DateTime  @default(now())
}

model ConsentEvent {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  status      ConsentStatus
  source      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit / Admin
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminNote {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  authorId       String
  author         User          @relation("AdminNoteAuthor", fields: [authorId], references: [id])
  note           String
  createdAt      DateTime      @default(now())

  @@index([conversationId])
}
