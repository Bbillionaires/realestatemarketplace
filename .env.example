# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_messaging?schema=public

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Field-level encryption for real phone numbers --------------------------
# 32-byte key, base64. Generate with: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=changeme-32-byte-base64-key-aaaaaaaaaaaaaaaaaaaaaaaa
# HMAC key used to build the lookup hash for phone numbers (separate from the
# encryption key so a leaked hash key alone cannot decrypt numbers).
PHONE_HASH_SECRET=changeme-hash-secret

# --- SMS provider -----------------------------------------------------------
# "mock" | "twilio" | "telnyx"
SMS_PROVIDER=mock

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# --- App -------------------------------------------------------------------
APP_BASE_URL=http://localhost:3001
DASHBOARD_BASE_URL=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
# Global ceiling shared across all routes per IP; sensitive routes below
# layer stricter per-route limits on top of this.
GLOBAL_RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
SMS_SEND_RATE_LIMIT_PER_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_TTL_SECONDS=600
